rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is a member of the household
    function isMember(householdId) {
      return request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    // User Profiles: Anyone can read profiles to show crew avatars/names on shared web wraps, only owner can write
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Usernames: Allow checking availability (unauthenticated) and claiming/deleting by the owner
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Households: Anyone can read household headers to show trip details on shared web wraps
    match /households/{householdId} {
      allow create: if request.auth != null;
      allow read: if true;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        (request.auth.uid in resource.data.members && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']))
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;

      // Allow public read for itinerary milestones, but write requires membership
      match /itinerary/{itineraryId} {
        allow read: if true;
        allow write: if isMember(householdId);
      }

      // Other subcollections still require membership
      match /expenses/{id} { allow read, write: if isMember(householdId); }
      match /chores/{id} { allow read, write: if isMember(householdId); }
      match /groceries/{id} { allow read, write: if isMember(householdId); }
      match /messages/{id} { allow read, write: if isMember(householdId); }
      match /packing_list/{id} { allow read, write: if isMember(householdId); }
      match /announcements/{id} { allow read, write: if isMember(householdId); }
      match /activities/{id} { allow read, write: if isMember(householdId); }
    }

    // Crash reports: Write-only for authenticated users, read-disabled on the client
    match /crashes/{crashId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Invitations: Offloaded entirely to secure backend Cloud Functions. Client access disabled.
    match /invitations/{invitationId} {
      allow read, write: if false;
    }
  }
}
